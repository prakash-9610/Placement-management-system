# Server Configuration
PORT=8000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net
CORS_ORIGIN=http://localhost:5173

# Authentication JWT Secrets
ACCESS_TOKEN_SECRET=your_jwt_access_secret_key_here
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_here
REFRESH_TOKEN_EXPIRY=10d

# Admin Credentials
ADMIN_SECRET_KEY=TPO_ADMIN_2026

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration (Nodemailer)
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Certificate Management & OCR Verification
CERTIFICATE_UPLOAD_DIR=./uploads/certificates
CERTIFICATE_MAX_FILE_SIZE_MB=10
ALLOWED_ISSUER_DOMAINS=coursera.org,udemy.com,edx.org,hackerrank.com,linkedin.com,nptel.ac.in,freecodecamp.org
